@@ -0,0 +1,85 @@
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as QQC2
+import org.kde.kirigami as Kirigami
+
+// A music item opened by the bridge. Playback is an explicit action in Couchside.
+Kirigami.Page {
+    id: page
+    objectName: "bridgeContent"
+    property real u: 1
+    property var item: ({})
+    property var sheet: null
+    padding: 0
+    globalToolBarStyle: Kirigami.ApplicationHeaderStyle.None
+    background: PageBackground { tint: app.backgroundColour }
+    function focusDefault() { actions.forceActiveFocus() }
+    Component.onCompleted: focusDefault()
+
+    RowLayout {
+        anchors { fill: parent; margins: 72 * page.u }
+        spacing: 56 * page.u
+        Image {
+            source: page.item.imageUrl || ""
+            Layout.preferredWidth: 420 * page.u
+            Layout.preferredHeight: 420 * page.u
+            fillMode: Image.PreserveAspectFit
+            asynchronous: true
+        }
+        ColumnLayout {
+            Layout.fillWidth: true
+            spacing: 28 * page.u
+            QQC2.Label {
+                text: page.item.kind || ""
+                textFormat: Text.PlainText
+                color: Theme.textDim
+                font.pixelSize: 28 * page.u
+            }
+            QQC2.Label {
+                text: page.item.title || ""
+                textFormat: Text.PlainText
+                Layout.fillWidth: true
+                wrapMode: Text.Wrap
+                color: Theme.text
+                font.pixelSize: 48 * page.u
+                font.bold: true
+            }
+            QQC2.Label {
+                text: page.item.subtitle || ""
+                textFormat: Text.PlainText
+                Layout.fillWidth: true
+                wrapMode: Text.Wrap
+                color: Theme.textDim
+                font.pixelSize: 30 * page.u
+            }
+            QQC2.Button {
+                id: actions
+                text: "Play or add to queue"
+                font.pixelSize: 32 * page.u
+                padding: 24 * page.u
+                Keys.onReturnPressed: clicked()
+                Keys.onEnterPressed: clicked()
+                Keys.onPressed: event => {
+                    if (event.key === Qt.Key_Select) { clicked(); event.accepted = true }
+                }
+                onClicked: page.sheet.open(page.item.title, [
+                    { id: "now", label: "Play now" },
+                    { id: "next", label: "Play next" },
+                    { id: "add", label: "Add to queue" }
+                ], actions, mode => app.playUri(page.item.uri, mode))
+                background: Rectangle {
+                    radius: 12 * page.u
+                    color: actions.activeFocus ? Theme.focus : Theme.surfaceHigh
+                    border.width: actions.activeFocus ? 5 * page.u : 0
+                    border.color: Theme.focus
+                }
+                contentItem: QQC2.Label {
+                    text: actions.text
+                    font: actions.font
+                    color: actions.activeFocus ? Theme.focusText : Theme.text
+                }
+            }
+            Item { Layout.fillHeight: true }
+        }
+    }
+}
diff --git a/tests/test_bridge_control.py b/tests/test_bridge_control.py
new file mode 100644
index 0000000..5c1a978
--- /dev/null
+++ b/tests/test_bridge_control.py
@@ -0,0 +1,45 @@
+import json
+from unittest.mock import AsyncMock
+
+import pytest
+
+from couchside.core.bridge_control import ControlError, Dispatcher, validate_content
+
+
+@pytest.mark.parametrize("kind,value", [("track", "library://track/123"),
+    ("album", "spotify--abc://album/123"), ("artist", "library://artist/1"),
+    ("playlist", "library://playlist/abc"), ("search", "Björk"), ("now_playing", "")])
+def test_content_types(kind, value):
+    assert validate_content(kind, value) == (kind, value)
+
+
+@pytest.mark.parametrize("kind,value", [("video", "123"), ("track", "https://example.org"),
+    ("track", "library://album/123"), ("track", "library://track/1?command=play"),
+    ("search", "x" * 513), ("search", "a\n"), ("now_playing", "some-id"), ("track", None)])
+def test_invalid_content(kind, value):
+    with pytest.raises(ControlError):
+        validate_content(kind, value)
+
+
+async def test_protocol_ui_only_and_idempotency():
+    execute = AsyncMock(return_value={"view": "search"})
+    dispatcher = Dispatcher(lambda: {"playback_owner": "music_assistant"}, execute)
+    request = dict(id="one", command="navigate", content_type="search", content_id="Björk")
+    first = await dispatcher.handle(json.dumps(request))
+    assert json.loads(first)["ok"]
+    assert await dispatcher.handle(json.dumps(request)) == first
+    execute.assert_awaited_once()
+    bad = json.loads(await dispatcher.handle(json.dumps({**request, "content_id": "other"})))
+    assert bad["error"]["code"] == "invalid_request"
+    for cmd in ("play", "pause", "seek", "eval"):
+        result = json.loads(await dispatcher.handle(json.dumps(dict(id=cmd, command=cmd))))
+        assert result["error"]["code"] == "unsupported"
+    execute.assert_awaited_once()
+
+
+@pytest.mark.parametrize("raw", ["{", "[]", '{}', '{"id":[],"command":"focus"}'])
+async def test_invalid_envelopes(raw):
+    execute = AsyncMock()
+    result = json.loads(await Dispatcher(lambda: {}, execute).handle(raw))
+    assert not result["ok"]
+    execute.assert_not_awaited()
