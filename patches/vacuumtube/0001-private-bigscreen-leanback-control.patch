diff --git a/src/preload/util/bigscreen-metadata.js b/src/preload/util/bigscreen-metadata.js
new file mode 100644
index 0000000..2cdda1e
--- /dev/null
+++ b/src/preload/util/bigscreen-metadata.js
@@ -0,0 +1,49 @@
+const {VIDEO_ID} = require('../../bridge-protocol')
+
+function text(value) {
+    if (typeof value === 'string') return value
+    if (typeof value?.simpleText === 'string') return value.simpleText
+    return Array.isArray(value?.runs) ? value.runs.map((run) => typeof run.text === 'string' ? run.text : '').join('') : ''
+}
+
+// Observe only public title/ID fields from responses Leanback already requested.
+class MetadataCache {
+    constructor() { this.titles = new Map(); this.searchQuery = null }
+
+    remember(id, title) {
+        if (typeof id !== 'string' || !VIDEO_ID.test(id) || typeof title !== 'string' || !title.trim()) return
+        this.titles.delete(id)
+        this.titles.set(id, title.slice(0, 2048))
+        while (this.titles.size > 64) this.titles.delete(this.titles.keys().next().value)
+    }
+
+    observe(json) {
+        for (const candidate of [json, json?.playerResponse]) {
+            this.remember(candidate?.videoDetails?.videoId, candidate?.videoDetails?.title)
+        }
+        const id = json?.currentVideoEndpoint?.watchEndpoint?.videoId
+        const contents = json?.contents?.singleColumnWatchNextResults?.results?.results?.contents
+        if (!Array.isArray(contents)) return
+        for (const section of contents) {
+            const items = section?.itemSectionRenderer?.contents
+            if (!Array.isArray(items)) continue
+            for (const item of items) {
+                const renderer = item?.videoMetadataRenderer || item?.musicWatchMetadataRenderer
+                if (renderer) this.remember(id, text(renderer.title))
+            }
+        }
+    }
+
+    observeRequest(url, body) {
+        if (typeof body !== 'string' || body.length > 1048576) return
+        try {
+            if (new URL(url, 'https://www.youtube.com').pathname !== '/youtubei/v1/search') return
+            const query = JSON.parse(body).query
+            if (typeof query === 'string' && query.length <= 200) this.searchQuery = query
+        } catch {}
+    }
+
+    get(id) { return this.titles.get(id) || '' }
+}
+
+module.exports = {MetadataCache}
diff --git a/src/preload/util/bigscreen-navigation.js b/src/preload/util/bigscreen-navigation.js
new file mode 100644
index 0000000..729bd25
--- /dev/null
+++ b/src/preload/util/bigscreen-navigation.js
@@ -0,0 +1,25 @@
+const {ControlError} = require('../../bridge-protocol')
+
+// Retry only the fixed content request while Leanback completes its startup route.
+async function confirmNavigation(request, {deliver, read, now = Date.now,
+    delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms))}) {
+    const startedAt = now()
+    let lastDelivery = startedAt
+    deliver(request)
+    while (now() - startedAt < 18000) {
+        const {view, media} = read()
+        if (request.content_type === 'video' && view.kind === 'watch'
+            && (view.video_id === request.content_id || media.video_id === request.content_id)) return 'video_selected'
+        if (request.content_type === 'playlist' && (view.playlist_id === request.content_id || media.playlist_id === request.content_id)) return 'playlist_selected'
+        if (request.content_type === 'search' && view.kind === 'search' && view.query === request.content_id) return 'search_opened'
+        // A listener may exist while the first navigation transition still discards links.
+        if (now() - lastDelivery >= 3000) {
+            deliver(request)
+            lastDelivery = now()
+        }
+        await delay(200)
+    }
+    throw new ControlError('navigation_failed', 'Leanback did not reach the requested content')
+}
+
+module.exports = {confirmNavigation}
diff --git a/src/preload/util/bigscreen-player.js b/src/preload/util/bigscreen-player.js
new file mode 100644
index 0000000..0f221d2
--- /dev/null
+++ b/src/preload/util/bigscreen-player.js
@@ -0,0 +1,34 @@
+const {VIDEO_ID, ControlError} = require('../../bridge-protocol')
+
+function snapshot(player) {
+    const result = {media: {state: 'idle'}, capabilities: []}
+    if (!player || typeof player.getVideoData !== 'function') return result
+    const data = player.getVideoData()
+    const videoId = data?.video_id
+    if (typeof videoId !== 'string' || !VIDEO_ID.test(videoId)) return result
+    const state = player.getPlayerState?.()
+    result.media = {video_id: videoId, title: data.title,
+        state: ({1: 'playing', 2: 'paused', 3: 'buffering'})[state] || 'idle',
+        position: player.getCurrentTime?.(), duration: player.getDuration?.(), playlist_id: player.getPlaylistId?.()}
+    if (state === 1 && typeof player.pauseVideo === 'function') result.capabilities.push('pause')
+    if (state === 2 && typeof player.playVideo === 'function') result.capabilities.push('play')
+    if (typeof player.stopVideo === 'function') result.capabilities.push('stop')
+    if ([1, 2].includes(state) && Number.isFinite(result.media.duration) && result.media.duration > 0
+        && typeof player.seekTo === 'function') result.capabilities.push('seek')
+    return result
+}
+
+function execute(player, request) {
+    const state = snapshot(player)
+    if (!state.capabilities.includes(request.command)) throw new ControlError('unsupported', 'Player command is unavailable')
+    if (request.command === 'seek') {
+        if (typeof request.position !== 'number' || !Number.isFinite(request.position)
+            || request.position < 0 || request.position > state.media.duration) throw new ControlError('invalid_request', 'Invalid seek position')
+        player.seekTo(request.position, true)
+    } else {
+        player[{play: 'playVideo', pause: 'pauseVideo', stop: 'stopVideo'}[request.command]]()
+    }
+    return {delivery: 'player_called'}
+}
+
+module.exports = {snapshot, execute}
diff --git a/src/preload/util/bigscreen-runtime.js b/src/preload/util/bigscreen-runtime.js
new file mode 100644
index 0000000..01cbb84
--- /dev/null
+++ b/src/preload/util/bigscreen-runtime.js
@@ -0,0 +1,99 @@
+const {ipcRenderer} = require('electron')
+const {navigationUrl} = require('../../bridge-protocol')
+const playerControl = require('./bigscreen-player')
+const resolveCommands = require('./resolveCommandModifiers')
+const {MetadataCache} = require('./bigscreen-metadata')
+const metadata = new MetadataCache()
+const {confirmNavigation} = require('./bigscreen-navigation')
+
+let volumeController = null
+let navigate = null
+let started = false
+
+function setVolumeController(controller) {
+    volumeController = controller
+    publish()
+}
+
+function setNavigation(handler) {
+    navigate = handler
+    publish()
+}
+
+function view() {
+    const route = new URL(location.hash.substring(1), location.href)
+    const kind = ({'/watch': 'watch', '/playlist': 'playlist', '/results': 'search', '/search': 'search', '/tv': 'home'})[route.pathname]
+    return {kind, query: route.searchParams.get('search_query') || route.searchParams.get('query') || (kind === 'search' ? metadata.searchQuery : null),
+        playlist_id: route.searchParams.get('list'), video_id: route.searchParams.get('v')}
+}
+
+function contentTypes() {
+    if (!navigate) return []
+    return resolveCommands.canResolveCommand() ? ['video', 'playlist', 'search'] : ['video', 'playlist']
+}
+
+function publish() {
+    try {
+        const player = document.querySelector('.html5-video-player')
+        const state = playerControl.snapshot(player)
+        if (volumeController) {
+            const volume = volumeController.snapshot()
+            state.media.volume = volume.level
+            state.media.muted = volume.muted
+            state.capabilities.push('volume_set', 'volume_mute')
+            const output = player?.getVolume?.()
+            if (Number.isFinite(output)) state.media.output_volume = output / 100
+        }
+        if (state.media.video_id && !state.media.title) state.media.title = metadata.get(state.media.video_id)
+        ipcRenderer.send('bigscreen-state', {...state, view: view(), ready: !!navigate,
+            content_types: contentTypes()})
+    } catch {
+        ipcRenderer.send('bigscreen-state', {ready: !!navigate, content_types: contentTypes()})
+    }
+}
+
+function deliverNavigation(request) {
+    if (!navigate) throw Object.assign(new Error('Leanback listener is not ready'), {code: 'not_ready'})
+    if (request.content_type === 'search') {
+        if (!resolveCommands.tryResolveCommand({searchEndpoint: {query: request.content_id}})) {
+            throw Object.assign(new Error('Search resolver is unavailable'), {code: 'not_ready'})
+        }
+    } else if (!navigate(navigationUrl(request.content_type, request.content_id))) {
+        throw Object.assign(new Error('Leanback did not accept delivery'), {code: 'not_ready'})
+    }
+}
+
+
+function start() {
+    if (started) return
+    started = true
+    require('./jsonModifiers').addModifier((json) => { metadata.observe(json); return json })
+    require('./xhrModifiers').addRequestModifier((url, body) => { metadata.observeRequest(url, body); return body })
+    ipcRenderer.on('bigscreen-command', async (event, request) => {
+        try {
+            let result
+            if (request.command === 'open') {
+                result = {delivery: await confirmNavigation(request, {deliver: deliverNavigation,
+                    read: () => ({view: view(), media: playerControl.snapshot(document.querySelector('.html5-video-player')).media})})}
+            } else if (request.command === 'volume_set' || request.command === 'volume_mute') {
+                if (!volumeController) throw Object.assign(new Error('Volume controller is unavailable'), {code: 'unsupported'})
+                if (request.command === 'volume_set') volumeController.setLevel(request.volume_level)
+                else volumeController.setMuted(request.muted)
+                result = {delivery: 'player_called'}
+            } else {
+                result = playerControl.execute(document.querySelector('.html5-video-player'), request)
+            }
+            publish()
+            ipcRenderer.send('bigscreen-complete', {id: request.id, ok: true, result})
+        } catch (error) {
+            ipcRenderer.send('bigscreen-complete', {id: request.id, ok: false,
+                error: {code: ['unsupported', 'invalid_request', 'not_ready', 'navigation_failed'].includes(error.code) ? error.code : 'command_failed',
+                    message: 'Leanback command could not be delivered'}})
+        }
+    })
+    const timer = setInterval(publish, 1000)
+    window.addEventListener('pagehide', () => { clearInterval(timer); ipcRenderer.send('bigscreen-gone') }, {once: true})
+    publish()
+}
+
+module.exports = {start, setNavigation, setVolumeController}
