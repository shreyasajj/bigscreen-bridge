index 0000000..83cebe8
--- /dev/null
+++ b/flatpak/install-bridge.sh
@@ -0,0 +1,31 @@
+#!/bin/sh
+# User-only development installation. The system Flatpak remains available for rollback.
+set -eu
+archive="${1:?Pass the bridge app.asar built from the matching installed version}"
+app_id=rocks.shy.VacuumTube
+stage_root="$HOME/.cache/vacuumtube-bridge-build"
+remote=bigscreen-vacuumtube
+mkdir -p "$stage_root"
+if [ ! -f "$stage_root/app/metadata" ]; then
+    flatpak info --show-commit "$app_id" > "$stage_root/base-commit"
+    flatpak build-init --base="$app_id" --base-version=stable "$stage_root/app" "$app_id" org.freedesktop.Sdk org.freedesktop.Platform 26.08
+fi
+cp "$archive" "$stage_root/app/files/bin/vacuumtube/resources/app.asar"
+if ! grep -q '^command=startvacuumtube$' "$stage_root/app/metadata"; then
+    flatpak build-finish "$stage_root/app" --command=startvacuumtube --share=ipc --share=network \
+        --socket=wayland --socket=fallback-x11 --socket=pulseaudio --device=all \
+        --filesystem=/run/udev:ro --filesystem=xdg-run/bigscreen-bridge:create \
+        --talk-name=org.freedesktop.ScreenSaver --talk-name=org.gnome.ScreenSaver \
+        --talk-name=org.mate.ScreenSaver --talk-name=org.cinnamon.ScreenSaver \
+        --talk-name=org.xfce.ScreenSaver --own-name=org.mpris.MediaPlayer2.chromium.*
+fi
+flatpak build-export "$stage_root/repo" "$stage_root/app" stable
+expected_url="file://$stage_root/repo"
+remote_url=$(flatpak remotes --user --columns=name,url | awk '$1 == "bigscreen-vacuumtube" {print $2}')
+if [ -n "$remote_url" ] && [ "$remote_url" != "$expected_url" ]; then
+    printf '%s\n' 'The development remote already points elsewhere; leaving it unchanged.' >&2
+    exit 1
+fi
+flatpak remote-add --user --no-gpg-verify --if-not-exists "$remote" "$expected_url"
+flatpak install --user --reinstall -y --noninteractive "$remote" "$app_id//stable"
+printf '%s\n' 'Installed the development build. Restart only the VacuumTube main process to load it.'
diff --git a/scripts/build-bridge-asar.cjs b/scripts/build-bridge-asar.cjs
new file mode 100755
index 0000000..9c4aabc
--- /dev/null
+++ b/scripts/build-bridge-asar.cjs
@@ -0,0 +1,32 @@
+#!/usr/bin/env node
+// Reuse the installed Linux Electron binary and matching production dependencies.
+const fs = require('node:fs')
+const path = require('node:path')
+const os = require('node:os')
+const asar = require('@electron/asar')
+
+async function main() {
+    const [baseline, output] = process.argv.slice(2)
+    if (!baseline || !output) throw new Error('Usage: build-bridge-asar.cjs installed-app.asar output.asar')
+    const root = path.resolve(__dirname, '..')
+    const sourcePackage = JSON.parse(fs.readFileSync(path.join(root, 'package.json')))
+    const installedPackage = JSON.parse(asar.extractFile(baseline, 'package.json'))
+    const dependencies = (value) => JSON.stringify(Object.entries(value || {}).sort(([a], [b]) => a.localeCompare(b)))
+    if (sourcePackage.version !== installedPackage.version || dependencies(sourcePackage.dependencies) !== dependencies(installedPackage.dependencies)) {
+        throw new Error('Installed version/dependencies differ; use a full Linux build instead')
+    }
+    const staging = fs.mkdtempSync(path.join(os.tmpdir(), 'vacuumtube-bridge-asar-'))
+    try {
+        asar.extractAll(baseline, staging)
+        fs.rmSync(path.join(staging, 'src'), {recursive: true, force: true})
+        for (const name of ['src', 'assets', 'locale']) {
+            const source = path.join(root, name)
+            if (fs.existsSync(source)) fs.cpSync(source, path.join(staging, name), {recursive: true})
+        }
+        await asar.createPackage(staging, output)
+        console.log('Built local bridge archive:', output)
+    } finally {
+        fs.rmSync(staging, {recursive: true, force: true})
+    }
+}
+main().catch((error) => { console.error(error.message); process.exitCode = 1 })
diff --git a/src/bridge-control.js b/src/bridge-control.js
new file mode 100644
index 0000000..81cb30d
--- /dev/null
+++ b/src/bridge-control.js
@@ -0,0 +1,147 @@
+const fs = require('fs')
+const path = require('path')
+const net = require('net')
+const {ControlError, validate, sanitizeState} = require('./bridge-protocol')
+
+const MAX_BYTES = 16384
+const CACHE_SIZE = 128
+
+function canonical(request) {
+    return JSON.stringify(Object.fromEntries(Object.entries(request).sort(([a], [b]) => a.localeCompare(b))))
+}
+
+class BridgeControl {
+    constructor({focus, dispatch, now = Date.now}) {
+        this.focus = focus
+        this.dispatch = dispatch
+        this.now = now
+        this.state = sanitizeState()
+        this.updatedAt = 0
+        this.cache = new Map()
+        this.pending = new Map()
+    }
+
+    publish(state) {
+        this.state = sanitizeState(state)
+        this.updatedAt = this.now()
+    }
+
+    invalidate() {
+        this.state = sanitizeState()
+        this.updatedAt = 0
+    }
+
+    snapshot() {
+        const fresh = this.updatedAt > 0 && this.now() - this.updatedAt < 5000
+        return {...this.state, ready: fresh && this.state.ready,
+            capabilities: fresh ? this.state.capabilities : [],
+            media: fresh ? {...this.state.media, updated_at: new Date(this.updatedAt).toISOString()} : {state: 'idle'}}
+    }
+
+    async run(request) {
+        if (request.command === 'get_state') return this.snapshot()
+        if (request.command === 'focus') {
+            await this.focus()
+            return {delivery: 'focus_requested'}
+        }
+        const state = this.snapshot()
+        if (!state.ready) throw new ControlError('not_ready', 'Leanback control is not ready')
+        if (request.command === 'open') {
+            if (!state.content_types.includes(request.content_type)) throw new ControlError('unsupported', 'Navigation type is unavailable')
+        } else if (!state.capabilities.includes(request.command)) {
+            throw new ControlError('unsupported', 'Player command is unavailable')
+        }
+        if (request.command === 'seek' && request.position > state.media.duration) throw new ControlError('invalid_request', 'Seek exceeds duration')
+        return await this.dispatch(request)
+    }
+
+    async execute(request) {
+        let id = typeof request?.id === 'string' ? request.id : null
+        try {
+            validate(request)
+            const key = canonical(request)
+            for (const entries of [this.cache, this.pending]) {
+                if (!entries.has(id)) continue
+                const previous = entries.get(id)
+                if (previous.key !== key) throw new ControlError('invalid_request', 'Request ID reused with different data')
+                return await previous.response
+            }
+            const mutating = !['get_state', 'focus'].includes(request.command)
+            if (mutating && [...this.pending.values()].some((item) => item.mutating)) throw new ControlError('busy', 'Another player command is in progress')
+            if (this.pending.size >= 16) throw new ControlError('busy', 'Too many pending commands')
+            const response = this.run(request).then((result) => ({id, ok: true, result}))
+                .catch((error) => ({id, ok: false, error: {code: error.code || 'command_failed',
+                    message: error instanceof ControlError ? error.message : 'Application command failed'}}))
+            this.pending.set(id, {key, response, mutating})
+            const result = await response
+            this.pending.delete(id)
+            if (result.ok || !['not_ready', 'busy'].includes(result.error.code)) {
+                this.cache.set(id, {key, response: result})
+                while (this.cache.size > CACHE_SIZE) this.cache.delete(this.cache.keys().next().value)
+            }
+            return result
+        } catch (error) {
+            return {id, ok: false, error: {code: error.code || 'invalid_request', message: error.message}}
+        }
+    }
+}
+
+async function listen(control, runtime = process.env.XDG_RUNTIME_DIR) {
+    if (!runtime || !path.isAbsolute(runtime)) throw new Error('No private runtime directory')
+    const directory = path.join(runtime, 'bigscreen-bridge')
+    fs.mkdirSync(directory, {mode: 0o700, recursive: true})
+    const info = fs.lstatSync(directory)
+    if (!info.isDirectory() || info.isSymbolicLink() || info.uid !== process.getuid()) throw new Error('Unsafe runtime directory')
+    fs.chmodSync(directory, 0o700)
+    const socketPath = path.join(directory, 'vacuumtube.sock')
+    if (fs.existsSync(socketPath)) {
+        const previous = fs.lstatSync(socketPath)
+        if (!previous.isSocket() || previous.uid !== process.getuid()) throw new Error('Unsafe socket path')
+        const alive = await new Promise((resolve) => {
+            const probe = net.createConnection(socketPath)
+            probe.once('connect', () => { probe.destroy(); resolve(true) })
+            probe.once('error', () => resolve(false))
+            probe.setTimeout(1000, () => { probe.destroy(); resolve(true) })
+        })
+        if (alive) throw new Error('Control socket is already in use')
+        fs.unlinkSync(socketPath)
+    }
+    const sockets = new Set()
+    const server = net.createServer((socket) => {
+        sockets.add(socket)
+        socket.on('close', () => sockets.delete(socket))
+        socket.on('error', () => {})
+        socket.setTimeout(30000, () => socket.destroy())
+        let buffer = Buffer.alloc(0)
+        let received = false
+        socket.on('data', async (chunk) => {
+            if (received) return
+            buffer = Buffer.concat([buffer, chunk])
+            if (buffer.length > MAX_BYTES) { socket.destroy(); return }
+            const newline = buffer.indexOf(10)
+            if (newline < 0) return
+            received = true
+            socket.pause()
+            try {
+                if (buffer.subarray(newline + 1).toString().trim()) throw new Error('Only one request per connection')
+                const request = JSON.parse(buffer.subarray(0, newline).toString())
+                socket.end(JSON.stringify(await control.execute(request)) + '\n')
+            } catch {
+                socket.end(JSON.stringify({id: null, ok: false, error: {code: 'invalid_request', message: 'Expected one bounded JSON line'}}) + '\n')
+            }
+        })
+    })
+    server.maxConnections = 16
+    await new Promise((resolve, reject) => { server.once('error', reject); server.listen(socketPath, resolve) })
+    fs.chmodSync(socketPath, 0o600)
+    const inode = fs.lstatSync(socketPath).ino
+    return {socketPath, close: async () => {
+        for (const socket of sockets) socket.destroy()
+        await new Promise((resolve) => server.close(resolve))
+        try {
+            if (fs.lstatSync(socketPath).ino === inode) fs.unlinkSync(socketPath)
+        } catch {}
+    }}
+}
+
+module.exports = {BridgeControl, listen}
diff --git a/src/bridge-electron.js b/src/bridge-electron.js
new file mode 100644
index 0000000..a2719b8
--- /dev/null
+++ b/src/bridge-electron.js
@@ -0,0 +1,81 @@
+const {BridgeControl, listen} = require('./bridge-control')
+const {ControlError, trustedFrame, sanitizeState} = require('./bridge-protocol')
+
+function setup({electron, getWindow, runtime}) {
+    let owner = null
+    let transport = null
+    const pending = new Map()
+    const control = new BridgeControl({
+        focus: async () => {
+            const win = getWindow()
+            if (!win || win.isDestroyed()) throw new ControlError('not_ready', 'No application window')
+            if (win.isMinimized()) win.restore()
+            win.show()
+            win.focus()
+        },
+        dispatch: (request) => new Promise((resolve, reject) => {
+            if (!owner) { reject(new ControlError('not_ready', 'Leanback frame is unavailable')); return }
+            const frame = owner
+            const timer = setTimeout(() => {
+                pending.delete(request.id)
+                reject(new ControlError('command_timeout', 'Leanback did not acknowledge the command'))
+            }, 20000)
+            pending.set(request.id, {frame, resolve, reject, timer})
+            try {
+                frame.send('bigscreen-command', request)
+            } catch {
+                clearTimeout(timer)
+                pending.delete(request.id)
+                reject(new ControlError('not_ready', 'Leanback frame is unavailable'))
+            }
+        })
+    })
+
+    function invalidate() {
+        owner = null
+        control.invalidate()
+        for (const item of pending.values()) {
+            clearTimeout(item.timer)
+            item.reject(new ControlError('not_ready', 'Leanback frame became unavailable'))
+        }
+        pending.clear()
+    }
+
+    electron.ipcMain.on('bigscreen-state', (event, payload) => {
+        if (!trustedFrame(event, getWindow())) return
+        const state = sanitizeState(payload)
+        // Prefer the frame with the player when Leanback is embedded in a subframe.
+        if (!owner || event.senderFrame === owner || state.media.video_id || !control.snapshot().media.video_id) {
+            owner = event.senderFrame
+            control.publish(state)
+        }
+    })
+    electron.ipcMain.on('bigscreen-complete', (event, payload) => {
+        if (!trustedFrame(event, getWindow()) || typeof payload?.id !== 'string') return
+        const item = pending.get(payload.id)
+        if (!item || event.senderFrame !== item.frame) return
+        clearTimeout(item.timer)
+        pending.delete(payload.id)
+        if (payload.ok === true && ['video_selected', 'playlist_selected', 'search_opened', 'player_called'].includes(payload.result?.delivery)) {
+            item.resolve({delivery: payload.result.delivery})
+        } else {
+            const code = ['unsupported', 'invalid_request', 'not_ready', 'navigation_failed'].includes(payload.error?.code) ? payload.error.code : 'command_failed'
+            item.reject(new ControlError(code, 'Leanback command failed'))
+        }
+    })
+    electron.ipcMain.on('bigscreen-gone', (event) => {
+        if (trustedFrame(event, getWindow()) && event.senderFrame === owner) invalidate()
+    })
+    if (process.platform === 'linux') {
+        listen(control, runtime).then((server) => { transport = server })
+            .catch(() => console.error('Bigscreen local control is unavailable'))
+    }
+    electron.app.on('before-quit', () => { invalidate(); transport?.close() })
+    return {watchWindow: (win) => {
+        win.webContents.on('did-start-navigation', (event, url, inPlace, mainFrame) => { if (mainFrame && !inPlace) invalidate() })
+        win.webContents.on('render-process-gone', invalidate)
+        win.on('closed', invalidate)
+    }}
+}
+
+module.exports = {setup}
diff --git a/src/bridge-protocol.js b/src/bridge-protocol.js
new file mode 100644
index 0000000..c5654cd
--- /dev/null
+++ b/src/bridge-protocol.js
@@ -0,0 +1,94 @@
+// Fixed-schema local commands. Never accept renderer code, filesystem paths or URLs.
+const VIDEO_ID = /^[A-Za-z0-9_-]{11}$/
+const PLAYLIST_ID = /^[A-Za-z0-9_-]{10,128}$/
+const COMMANDS = ['get_state', 'focus', 'open', 'play', 'pause', 'stop', 'seek', 'volume_set', 'volume_mute']
+const PLAYER_COMMANDS = ['play', 'pause', 'stop', 'seek', 'volume_set', 'volume_mute']
+const CONTENT_TYPES = ['video', 'playlist', 'search']
+
+class ControlError extends Error {
+    constructor(code, message) {
+        super(message)
+        this.code = code
+    }
+}
+
+function validate(request) {
+    const invalid = (message) => { throw new ControlError('invalid_request', message) }
+    if (!request || typeof request !== 'object' || Array.isArray(request)) invalid('Expected a JSON object')
+    if (typeof request.id !== 'string' || !request.id.length || request.id.length > 128) invalid('A bounded string request ID is required')
+    if (!COMMANDS.includes(request.command)) throw new ControlError('unsupported', 'Unsupported command')
+    const allowed = ['id', 'command']
+    if (request.command === 'open') allowed.push('content_type', 'content_id')
+    if (request.command === 'seek') allowed.push('position')
+    if (request.command === 'volume_set') allowed.push('volume_level')
+    if (request.command === 'volume_mute') allowed.push('muted')
+    if (Object.keys(request).some((key) => !allowed.includes(key))) invalid('Unknown request fields')
+    if (request.command === 'seek' && (typeof request.position !== 'number' || !Number.isFinite(request.position) || request.position < 0)) invalid('Invalid seek position')
+    if (request.command === 'volume_set' && (typeof request.volume_level !== 'number' || !Number.isFinite(request.volume_level) || request.volume_level < 0 || request.volume_level > 1)) invalid('Volume must be between zero and one')
+    if (request.command === 'volume_mute' && typeof request.muted !== 'boolean') invalid('Muted must be boolean')
+    if (request.command === 'open') {
+        const value = request.content_id
+        if (!CONTENT_TYPES.includes(request.content_type)) throw new ControlError('unsupported', 'Unsupported content type')
+        if (typeof value !== 'string') invalid('Content ID must be a string')
+        if (request.content_type === 'video' && !VIDEO_ID.test(value)) invalid('Invalid YouTube video ID')
+        if (request.content_type === 'playlist' && !PLAYLIST_ID.test(value)) invalid('Invalid YouTube playlist ID')
+        if (request.content_type === 'search' && (!value.trim() || value.length > 200 || /[\u0000-\u001f\u007f]/.test(value))) invalid('Invalid search text')
+    }
+    return request
+}
+
+function navigationUrl(type, value) {
+    validate({id: 'url', command: 'open', content_type: type, content_id: value})
+    if (type === 'video') return 'https://www.youtube.com/watch?v=' + encodeURIComponent(value)
+    if (type === 'playlist') return 'https://www.youtube.com/playlist?list=' + encodeURIComponent(value)
+    return 'https://www.youtube.com/results?search_query=' + encodeURIComponent(value)
+}
+
+function sanitizeState(input = {}) {
+    if (!input || typeof input !== 'object' || Array.isArray(input)) input = {}
+    const contentTypes = Array.isArray(input.content_types) ? input.content_types : []
+    const capabilities = Array.isArray(input.capabilities) ? input.capabilities : []
+    const state = {protocol: 1, ready: input.ready === true, content_types: [], capabilities: [], media: {state: 'idle'}}
+    state.content_types = CONTENT_TYPES.filter((type) => contentTypes.includes(type))
+    const view = input.view || {}
+    if (['watch', 'playlist', 'search', 'home'].includes(view.kind)) {
+        state.view = {kind: view.kind}
+        if (typeof view.video_id === 'string' && VIDEO_ID.test(view.video_id)) state.view.video_id = view.video_id
+        if (typeof view.query === 'string' && view.query.length <= 200) state.view.query = view.query
+        if (typeof view.playlist_id === 'string' && PLAYLIST_ID.test(view.playlist_id)) state.view.playlist_id = view.playlist_id
+    }
+    const media = input.media || {}
+    if (typeof media.video_id === 'string' && VIDEO_ID.test(media.video_id)) {
+        if (typeof media.playlist_id === 'string' && PLAYLIST_ID.test(media.playlist_id)) state.media.playlist_id = media.playlist_id
+        state.media.video_id = media.video_id
+        state.media.title = typeof media.title === 'string' ? media.title.slice(0, 2048) : ''
+        state.media.thumbnail = `https://i.ytimg.com/vi/${media.video_id}/hqdefault.jpg`
+        state.media.state = ['playing', 'paused', 'buffering'].includes(media.state) ? media.state : 'idle'
+        for (const key of ['position', 'duration']) {
+            if (typeof media[key] === 'number' && Number.isFinite(media[key]) && media[key] >= 0) state.media[key] = media[key]
+        }
+    }
+    for (const key of ['volume', 'output_volume']) {
+        if (typeof media[key] === 'number' && Number.isFinite(media[key]) && media[key] >= 0 && media[key] <= 1) state.media[key] = media[key]
+    }
+    if (typeof media.muted === 'boolean') state.media.muted = media.muted
+    state.capabilities = PLAYER_COMMANDS.filter((command) => {
+        if (!capabilities.includes(command)) return false
+        if (command === 'volume_set') return state.media.volume !== undefined
+        if (command === 'volume_mute') return state.media.volume !== undefined && state.media.muted !== undefined
+        return !!state.media.video_id && (command !== 'seek' || state.media.duration > 0)
+    })
+    return state
+}
+
+function trustedFrame(event, win) {
+    if (!win || win.isDestroyed() || event.sender !== win.webContents) return false
+    try {
+        const url = new URL(event.senderFrame.url)
+        return url.protocol === 'https:' && url.hostname === 'www.youtube.com' && !url.port && url.pathname === '/tv'
+    } catch {
+        return false
+    }
+}
+
+module.exports = {ControlError, validate, navigationUrl, sanitizeState, trustedFrame, VIDEO_ID}
