+#!/bin/sh
+# Fast user-only development build against an installed 0.8.1 Stremio Flatpak.
+# The full production dependency build remains the adjacent YAML manifest.
+set -eu
+app_id=io.github.shreyasajj.StremioTV
+source_root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
+# script is native/packaging/, so the parent of native is the repository root.
+flatpak info --user "$app_id" >/dev/null
+flatpak install --user -y --noninteractive flathub org.kde.Sdk//6.10 io.qt.qtwebengine.BaseApp//6.10
+stage_root=$(mktemp -d "$HOME/.cache/stremio-bridge-XXXXXX")
+app_root="$stage_root/app"
+headers_root="$stage_root/headers"
+flatpak info --show-commit "$app_id" > "$stage_root/base-commit"
+flatpak build-init --base="$app_id" --base-version=master "$app_root" "$app_id" org.kde.Sdk org.kde.Platform 6.10
+base_root=$(flatpak info --show-location io.qt.qtwebengine.BaseApp//6.10)
+for part in include lib/cmake lib/x86_64-linux-gnu/cmake lib/x86_64-linux-gnu/metatypes lib/metatypes mkspecs; do
+    if [ -d "$base_root/files/$part" ]; then
+        mkdir -p "$app_root/files/$part"
+        cp -a "$base_root/files/$part/." "$app_root/files/$part/"
+    fi
+done
+cp -a "$base_root/files/lib/libexec/qwebengine_convert_dict" "$app_root/files/lib/libexec/"
+python3 - "$headers_root" <<'PY'
+from pathlib import Path
+import sys
+from urllib.request import urlopen
+root=Path(sys.argv[1])
+(root/'include/mpv').mkdir(parents=True)
+(root/'pkgconfig').mkdir()
+mpv='https://raw.githubusercontent.com/mpv-player/mpv/b0841e8c4d156b8403dc1876c4cbd9011eb583f3/include/mpv/'
+urls={f'include/mpv/{f}':mpv+f for f in ('client.h','render.h','render_gl.h','stream_cb.h')}
+urls['include/mosquitto.h']='https://raw.githubusercontent.com/eclipse-mosquitto/mosquitto/766fa2c5a9bed6c65249cf555f430b982c417480/include/mosquitto.h'
+for name,url in urls.items():
+    (root/name).write_bytes(urlopen(url,timeout=30).read())
+for name,version,lib in [('mpv','0.42.0','mpv'),('libmosquitto','2.0.22','mosquitto')]:
+    (root/'pkgconfig'/f'{name}.pc').write_text(f'Name: {name}\nDescription: Matching installed media headers\nVersion: {version}\nLibs: -L/app/lib -l{lib}\nCflags: -I{root}/include\n')
+PY
+flatpak build --filesystem="$source_root" --filesystem="$stage_root" \
+    --env=PKG_CONFIG_PATH="$headers_root/pkgconfig" "$app_root" sh -c '
+        set -e
+        cmake -S "$1/native" -B "$2/obj" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/app -DCMAKE_PREFIX_PATH=/app
+        cmake --build "$2/obj" -j4
+        cmake --install "$2/obj"
+    ' sh "$source_root" "$stage_root"
+# Remove only development files added to this disposable staging tree.
+rm -rf "$app_root/files/include" "$app_root/files/lib/cmake" "$app_root/files/lib/x86_64-linux-gnu/cmake" \
+    "$app_root/files/lib/pkgconfig" "$app_root/files/lib/x86_64-linux-gnu/metatypes" \
+    "$app_root/files/lib/metatypes" "$app_root/files/mkspecs"
+flatpak build-finish "$app_root" --command=stremio-tv-native \
+    --share=ipc --share=network --socket=wayland --socket=fallback-x11 --socket=pulseaudio \
+    --filesystem=xdg-run/pipewire-0:ro --device=all --talk-name=org.freedesktop.ScreenSaver \
+    --own-name=io.github.shreyasajj.StremioTV.Control \
+    --env=QTWEBENGINEPROCESS_PATH=/app/bin/QtWebEngineProcess \
+    --env=QTWEBENGINE_DICTIONARIES_PATH=/app/qtwebengine_dictionaries
+flatpak build-export "$stage_root/repo" "$app_root"
+flatpak build-bundle "$stage_root/repo" "$stage_root/StremioTV-bridge.flatpak" "$app_id" master
+printf '%s\n' "Built: $stage_root/StremioTV-bridge.flatpak" "Rollback commit recorded in: $stage_root/base-commit"
+if [ "${1:-}" = --install ]; then
+    flatpak install --user --reinstall -y --noninteractive "$stage_root/StremioTV-bridge.flatpak"
+fi
diff --git a/ui/js/bridge-protocol.js b/ui/js/bridge-protocol.js
new file mode 100644
index 0000000..afd8007
--- /dev/null
+++ b/ui/js/bridge-protocol.js
@@ -0,0 +1,69 @@
+// UI bridge contract, kept independent of DOM/native APIs for deterministic tests.
+const ID = /^[A-Za-z0-9][A-Za-z0-9:._-]{0,255}$/;
+const validId = value => typeof value === 'string' && ID.test(value) && !/[\r\n]/.test(value);
+export class BridgeError extends Error {
+  constructor(code, message) { super(message); this.code = code; }
+}
+export function validateRequest(request) {
+  const fail = (message) => { throw new BridgeError('invalid_request', message); };
+  if (!request || typeof request !== 'object' || Array.isArray(request)) fail('Expected an object');
+  if (typeof request.id !== 'string' || !request.id.length || request.id.length > 128) fail('Request ID required');
+  const allowed = new Set(['id', 'command']);
+  if (request.command === 'open') {
+    ['content_type', 'content_id', 'resume'].forEach(k => allowed.add(k));
+    if (!['movie', 'series', 'episode'].includes(request.content_type)) throw new BridgeError('unsupported', 'Unsupported content type');
+    if (request.resume !== undefined && typeof request.resume !== 'boolean') fail('Resume must be boolean');
+    if (request.content_type === 'episode') {
+      const c = request.content_id;
+      if (!c || typeof c !== 'object' || Array.isArray(c) || Object.keys(c).length !== 2
+          || !validId(c.series_id) || !validId(c.video_id)
+          || typeof c.series_id !== 'string' || typeof c.video_id !== 'string') fail('Episode requires series_id and video_id');
+    } else if (!validId(request.content_id)) fail('Invalid Stremio ID');
+  } else if (request.command === 'seek') {
+    allowed.add('position');
+    if (typeof request.position !== 'number' || !Number.isFinite(request.position) || request.position < 0) fail('Invalid seek position');
+  } else if (!['play', 'pause', 'stop'].includes(request.command)) throw new BridgeError('unsupported', 'Unsupported renderer command');
+  if (Object.keys(request).some(k => !allowed.has(k))) fail('Unknown request fields');
+  return request;
+}
+
+export async function executeRequest(raw, deps) {
+  const request = validateRequest(raw);
+  const guard = () => {
+    if (deps.cancelled?.()) throw new BridgeError('command_timeout', 'The application command was cancelled');
+  };
+  guard();
+  if (request.command !== 'open') {
+    const cmd = request.command === 'seek' ? {action: 'seek_absolute', position: request.position} : {action: request.command};
+    if (!deps.runPlayerCommand(cmd)) throw new BridgeError('not_playing', 'No active player supports this command');
+    return {command: request.command};
+  }
+  const type = request.content_type === 'movie' ? 'movie' : 'series';
+  const id = request.content_type === 'episode' ? request.content_id.series_id : request.content_id;
+  let meta;
+  try { meta = await deps.getMeta(type, id); } catch { throw new BridgeError('content_not_found', 'The installed addons could not resolve this title'); }
+  guard();
+  if (!meta || (meta.id && meta.id !== id)) throw new BridgeError('content_not_found', 'Title not found');
+  const episode = request.content_type === 'episode'
+    ? meta.videos?.find(v => v.id === request.content_id.video_id) : null;
+  if (request.content_type === 'episode' && !episode) throw new BridgeError('content_not_found', 'Episode not found in this series');
+  const entry = request.resume ? deps.getLibraryEntry(type, id) : null;
+  if (request.resume && (!entry || !(entry.time > 10) || (episode && entry.videoId !== episode.id)))
+    throw new BridgeError('resume_unavailable', 'No matching stored playback to resume');
+  // Validate and resolve before changing the current UI/player.
+  deps.closePlayer();
+  deps.closeModals();
+  const screen = await deps.push('detail', {type, id, resolvedMeta: meta, videoId: episode?.id});
+  guard();
+  if (!screen) throw new BridgeError('navigation_failed', 'The detail page did not open');
+  if (episode) deps.focusEpisode(screen, episode.id);
+  let delivery = 'detail';
+  if (request.resume) {
+    const result = await deps.resumeFlow(meta, entry);
+    guard();
+    if (!result || !['stream_selection', 'playing_requested'].includes(result.status))
+      throw new BridgeError(result?.status || 'resume_failed', 'Stored playback could not be resumed');
+    delivery = result.status;
+  }
+  return {type, id, video_id: episode?.id || null, delivery};
+}
diff --git a/ui/js/bridgecontrol.js b/ui/js/bridgecontrol.js
new file mode 100644
index 0000000..a97c6c1
--- /dev/null
+++ b/ui/js/bridgecontrol.js
@@ -0,0 +1,48 @@
+import { executeRequest } from './bridge-protocol.js';
+import { getMeta } from './addons.js';
+import { Storage } from './storage.js';
+import { closePlayer } from './player.js';
+import { resumeFlow } from './streams.js';
+import { runPlayerCommand } from './homeassistant.js';
+import { closeTopModal, hasOpenModal } from './ui.js';
+import { Nav } from './nav.js';
+
+export function initBridgeControl(router) {
+  const bridge = window.shell?.bridge;
+  if (!bridge) return;
+  const pending = new Map();
+  const closeModals = () => { while (hasOpenModal()) closeTopModal(); };
+  bridge.onCancel((id) => {
+    const operation = pending.get(id);
+    if (!operation) return;
+    operation.cancelled = true;
+    if (operation.changed) closeModals();
+  });
+  bridge.onRequest(async (request) => {
+    const operation = {cancelled:false, changed:false, deadline:Date.now() + 18000};
+    pending.set(request.id, operation);
+    try {
+      const result = await executeRequest(request, {
+        getMeta, resumeFlow, runPlayerCommand,
+        cancelled: () => operation.cancelled || Date.now() > operation.deadline,
+        closePlayer: () => { operation.changed = true; closePlayer(); },
+        getLibraryEntry: (type, id) => Storage.getLibraryEntry(type, id),
+        closeModals,
+        push: (...args) => router.push(...args),
+        focusEpisode: (screen, videoId) => {
+          const item = [...screen.querySelectorAll('[data-video-id]')].find(el => el.dataset.videoId === videoId);
+          if (!item) throw new Error('Requested episode was not rendered');
+          Nav.focus(item);
+        },
+      });
+      bridge.complete(request.id, {ok: true, result});
+    } catch (error) {
+      bridge.complete(request.id, {ok: false, error: {
+        code: error.code || 'navigation_failed', message: error.code ? error.message : 'Application command failed',
+      }});
+    } finally {
+      pending.delete(request.id);
+    }
+  });
+  bridge.ready(true);
+}
diff --git a/test/bridge-protocol.test.js b/test/bridge-protocol.test.js
new file mode 100644
index 0000000..d3eb6ff
--- /dev/null
+++ b/test/bridge-protocol.test.js
@@ -0,0 +1,59 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const protocol = import('data:text/javascript;base64,' + fs.readFileSync(require('node:path').join(__dirname, '../ui/js/bridge-protocol.js')).toString('base64'));
+function deps() {
+  const calls = [];
+  return {calls, getMeta: async () => ({id: 'tt123', videos: [{id: 'tt123:2:3'}]}),
+    getLibraryEntry: () => null, closePlayer: () => calls.push('close'), closeModals: () => {},
+    push: async (name, params) => { calls.push(params); return {}; },
+    focusEpisode: (_, id) => calls.push(id), resumeFlow: async () => ({status: 'stream_selection'}),
+    runPlayerCommand: cmd => {calls.push(cmd); return true;}};
+}
+test('valid movie and exact episode navigation; no autoplay', async () => {
+  const {executeRequest} = await protocol;
+  const d = deps();
+  let result = await executeRequest({id:'one', command:'open',content_type:'movie',content_id:'tt123'},d);
+  assert.equal(result.delivery,'detail');
+  result = await executeRequest({id:'two',command:'open',content_type:'episode',content_id:{series_id:'tt123',video_id:'tt123:2:3'}},d);
+  assert.equal(result.video_id,'tt123:2:3');
+  assert.equal(d.calls.at(-1),'tt123:2:3');
+});
+test('missing episode or resume preserves existing player', async () => {
+  const {executeRequest} = await protocol;
+  for (const patch of [{content_type:'episode',content_id:{series_id:'tt123',video_id:'missing'}},
+                      {content_type:'movie',content_id:'tt123',resume:true}]) {
+    const d=deps();
+    await assert.rejects(executeRequest({id:'one',command:'open',...patch},d));
+    assert.deepEqual(d.calls,[]);
+  }
+});
+test('resume uses stored progress and reports stream selection, not playing', async () => {
+  const {executeRequest} = await protocol;const d=deps();d.getLibraryEntry=()=>({time:42});
+  assert.equal((await executeRequest({id:'one',command:'open',content_type:'movie',content_id:'tt123',resume:true},d)).delivery,'stream_selection');
+});
+test('unsafe IDs, extra fields and malformed seeks are rejected', async () => {
+  const {validateRequest}=await protocol;
+  for (const r of [{command:'open',content_type:'movie',content_id:'https://example.com'},
+    {command:'open',content_type:'movie',content_id:'tt123\n'},
+    {command:'open',content_type:'movie',content_id:'tt123',resume:'yes'},
+    {command:'seek',position:-1},{command:'seek',position:NaN},{command:'seek',position:true},
+    {command:'play',javascript:'alert(1)'},{command:'open',content_type:'episode',content_id:{series_id:'tt123',video_id:'tt123:1:2',extra:true}}])
+    assert.throws(()=>validateRequest({id:'one',...r}));
+});
+test('playback requests use existing handler and fail if no player', async()=>{
+  const {executeRequest}=await protocol;const d=deps();
+  await executeRequest({id:'one',command:'seek',position:12},d);
+  assert.deepEqual(d.calls,[{action:'seek_absolute',position:12}]);
+  d.runPlayerCommand=()=>false;
+  await assert.rejects(executeRequest({id:'two',command:'pause'},d),{code:'not_playing'});
+});
+
+test('a cancelled slow lookup cannot navigate or stop the existing player', async () => {
+  const {executeRequest}=await protocol;const d=deps();
+  let cancelled=false;
+  d.cancelled=()=>cancelled;
+  d.getMeta=async()=>{cancelled=true;return {id:'tt123'};};
+  await assert.rejects(executeRequest({id:'one',command:'open',content_type:'movie',content_id:'tt123'},d),{code:'command_timeout'});
+  assert.deepEqual(d.calls,[]);
+});
diff --git a/docs/bigscreen-bridge.md b/docs/bigscreen-bridge.md
new file mode 100644
index 0000000..499e539
--- /dev/null
+++ b/docs/bigscreen-bridge.md
@@ -0,0 +1,81 @@
+# Native Bigscreen Bridge control
+
+This branch adds a local application control endpoint, independent of the existing
+Home Assistant MQTT client. It reuses the Qt WebChannel, router, saved progress and
+libmpv player. Existing MQTT topics and payload schemas remain unchanged.
+
+## Interface
+
+Session-bus name/interface: `io.github.shreyasajj.StremioTV.Control`.
+Object: `/io/github/shreyasajj/StremioTV/Control`. Method: `Execute(JSON) → JSON`.
+The Flatpak grants ownership of this one name. Native builds require Qt DBus.
+A D-Bus service-name lease is acquired before creating the window; a secondary
+launch asks the existing window for focus and exits without another player.
+
+Requests carry a string `id`, at most 128 characters. JSON is limited to 16 KiB.
+The endpoint rejects unknown fields and commands, arbitrary URLs, unsafe content
+IDs and nonfinite/negative seek positions. It has no generic shell, JavaScript,
+mpv command, credential, configuration or local-file endpoint. The session bus
+trusts the logged-in Unix user; the network bridge supplies bearer authentication.
+
+```json
+{"id":"request-1","command":"open","content_type":"movie","content_id":"tt0133093"}
+{"id":"request-2","command":"open","content_type":"episode","content_id":{"series_id":"tt0944947","video_id":"tt0944947:1:2"}}
+{"id":"request-3","command":"pause"}
+{"id":"request-4","command":"seek","position":120}
+```
+
+Commands: `get_state`, `focus`, `open`, `play`, `pause`, `stop`, `seek` (absolute
+seconds). Content types: `movie`, `series`, `episode`. IDs support alphanumerics,
+colon, dot, underscore and hyphen, up to 256 characters; other ID forms are
+explicitly rejected. No volume/next/previous support is advertised.
+
+Focus preserves the existing content. Open resolves metadata before changing
+content; unknown titles or episodes return errors. Episode navigation chooses its
+season and focuses that exact episode. Opening a detail page does not start media.
+Set `resume: true` to reuse matching saved progress. Resume returns
+`delivery: "stream_selection"` when the existing UI asks the user to choose a
+stream; this acknowledgement does not mean playback has started. Missing saved
+progress returns `resume_unavailable`. The existing completed-item/next-episode
+resume policy remains in effect.
+
+Player commands use the same handler as the remote/MQTT controls. Without an active
+player they return `not_playing`. The state reports title, episode label, poster,
+content/video ID, position, duration, playback state and UTC observation time.
+The added identifiers are not passed to the legacy MQTT publisher.
+
+Mutating calls wait for a renderer acknowledgement, with a bounded timeout and
+cancellation signal. A cancelled slow metadata lookup cannot later stop playback
+or navigate. Duplicate request IDs return cached responses; changing a request
+while retaining its ID is rejected. A busy renderer command returns an error.
+Readiness resets on document reload or renderer loss.
+
+## Build and validation
+
+The normal production Flatpak build is
+`native/packaging/flatpak/io.github.shreyasajj.StremioTV.yml`. For a user-only
+incremental development build on the Linux TV, while 0.8.1 is installed:
+
+```sh
+sh native/packaging/build-bridge-flatpak.sh
+# Add --install to install the resulting user bundle.
+```
+
+This path reuses the installed media libraries, obtains their matching pinned
+public headers, and uses the Qt 6.10 SDK/BaseApp development files. It records the
+base commit for rollback and builds a bundle in a new user cache directory.
+It does not rebuild FFmpeg/mpv or publish anything. Use the full manifest if media
+library versions change. Keep profile data in the existing Flatpak app ID.
+
+```sh
+node --test test/bridge-protocol.test.js
+# Native Qt + libmpv + MQTT + local D-Bus checks in a private test session:
+docker build -t bigscreen-stremio-dev native/dev
+docker run --rm -v "$PWD":/src -w /src bigscreen-stremio-dev \
+  dbus-run-session -- sh native/dev/run-tests.sh
+```
+
+The native suite tests actual pause/play/seek/stop, exact movie/episode navigation,
+stored-position resume, idempotent commands, duplicate launches, state metadata,
+and the existing MQTT regression checks. Mock addon/sample media stay inside the
+container; testing must not overwrite the TV's installed addon credentials.
